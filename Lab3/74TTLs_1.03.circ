  <circuit name="JK Flip-Flop (Master Slave Std/L-series)">
    <a name="circuit" val="JK Flip-Flop (Master Slave Std/L-series)"/>
    <a name="clabel" val=""/>
    <a name="clabelup" val="north"/>
    <a name="clabelfont" val="SansSerif bold 12"/>
    <appear>
      <rect fill="none" height="40" stroke="#0080ff" stroke-width="2" width="40" x="70" y="70"/>
      <text font-family="MS UI Gothic" font-size="12" text-anchor="start" x="73" y="86">J</text>
