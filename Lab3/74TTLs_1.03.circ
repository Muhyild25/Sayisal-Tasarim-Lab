      <circ-anchor facing="east" height="6" width="6" x="67" y="77"/>
    </appear>
    <wire from="(100,180)" to="(120,180)"/>
    <wire from="(150,180)" to="(170,180)"/>
    <comp lib="6" loc="(70,150)" name="Text">
      <a name="text" val="See Logisim User's Guide - Guide to Being a Logisim User - Value propagation - Gate delays"/>
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="6" loc="(70,470)" name="Text">
      <a name="text" val="Retriggering can be disabled like 74221 by connecting /Q to Enable."/>
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="6" loc="(72,310)" name="Text">
      <a name="text" val="This can be used to simulate random initial values such as flip-flops."/>
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="6" loc="(70,90)" name="Text">
      <a name="text" val="This circuit delays the propagation evaluation of the input signal by 5 steps."/>
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
    </comp>
    <comp loc="(80,350)" name="Power On Reset">
      <a name="label" val=" Power On Reset"/>
      <a name="labelloc" val="east"/>
      <a name="labelfont" val="SansSerif bold 12"/>
    </comp>
    <comp loc="(80,530)" name="@Retriggerable Monostable Multivibrator">
      <a name="label" val=" Retriggerble Monostable Multivibrator"/>
      <a name="labelloc" val="east"/>
      <a name="labelfont" val="SansSerif bold 12"/>
    </comp>
    <comp lib="6" loc="(60,70)" name="Text">
      <a name="text" val="◆ Propergation Delay"/>
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
    </comp>
    <comp loc="(120,180)" name="Propergation Delay"/>
    <comp lib="0" loc="(100,180)" name="Pin">
      <a name="tristate" val="false"/>
      <a name="labelfont" val="SansSerif bold 12"/>
    </comp>
    <comp lib="6" loc="(50,30)" name="Text">
      <a name="text" val="Special Components (2 of 2)"/>
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="6" loc="(70,130)" name="Text">
      <a name="text" val="This can be used to prevent oscillations caused by propagation evaluation."/>
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="5" loc="(170,180)" name="LED"/>
    <comp lib="6" loc="(72,270)" name="Text">
      <a name="text" val="Power On Reset provides reset pulse less than one tick immediately after the reset."/>
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="6" loc="(60,410)" name="Text">
      <a name="text" val="◆ Monostable Multivibrator"/>
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="6" loc="(60,250)" name="Text">
      <a name="text" val="◆ Power On Reset"/>
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="6" loc="(72,290)" name="Text">
      <a name="text" val="North and south random reset outputs will output a pulse to either of them at reset."/>
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="6" loc="(72,430)" name="Text">
      <a name="text" val="This monostable multivibrator uses an internal timer to generate pulses instead of the analog discharge phenomenon."/>
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="6" loc="(72,450)" name="Text">
      <a name="text" val="When using this circuits, the simulator ticks must be enabled and the frequency set appropriately."/>
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="6" loc="(80,110)" name="Text">
      <a name="text" val="In addition, short pulses within 3 steps are extended to 3 steps."/>
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
    </comp>
  </circuit>
