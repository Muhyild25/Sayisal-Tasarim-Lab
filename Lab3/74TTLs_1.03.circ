    <comp lib="6" loc="(90,720)" name="Text">
      <a name="text" val="please contact me at below email address."/>
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="6" loc="(90,220)" name="Text">
      <a name="text" val="Those for which gate-level logic diagrams are not provided are not included."/>
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="6" loc="(90,570)" name="Text">
      <a name="text" val="-P: Positive (High) Level Trigger"/>
