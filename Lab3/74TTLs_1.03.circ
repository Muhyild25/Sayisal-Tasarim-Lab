      <a name="halign" val="left"/>
    </comp>
    <comp lib="6" loc="(90,240)" name="Text">
      <a name="text" val="Glitch, Skew, Hazard, Racing, Fanout limitation, and some abnormal conditions may not be perfectly reproduced."/>
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="6" loc="(90,280)" name="Text">
      <a name="text" val="The pin number assignments are for popular dual inline packages."/>
      <a name="font" val="SansSerif bold 12"/>
      <a name="halign" val="left"/>
    </comp>
    <comp lib="6" loc="(90,680)" name="Text">
